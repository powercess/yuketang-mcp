{
  "name": "@powercess/yuketang-mcp",
  "version": "0.1.1",
  "description": "雨课堂（Yuketang）MCP 服务器：扫码登录，读取课程/课件/课堂回顾/AI 思维导图/回放时间线/作业进度，供 AI 助手直接调用",
  "type": "module",
  "license": "MIT",
  "author": "powercess",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "yuketang",
    "rainclassroom",
    "雨课堂",
    "education",
    "courseware"
  ],
  "homepage": "https://github.com/powercess/yuketang-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powercess/yuketang-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/powercess/yuketang-mcp/issues"
  },
  "engines": {
    "node": ">=23.4"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "yuketang-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.0"
  }
}
